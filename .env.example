# Copy to .env.local and fill in. .env* files are git-ignored; never commit real values.

# Neon Postgres connection string (Neon console > Connect). Use the pooled URL.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/vikmaker?sslmode=require"

# svenskalag.se integration (server-side only, never exposed to the browser)
SVENSKALAG_BASE_URL="https://www.svenskalag.se"
# Path to the team on svenskalag.se
SVENSKALAG_TEAM_PATH="/vendelsoik-p10"
SVENSKALAG_USERNAME=""
SVENSKALAG_PASSWORD=""

# Protects the sync route. Vercel Cron sends it as a bearer token.
CRON_SECRET=""
